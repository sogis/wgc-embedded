{
  "name": "qwc2-embedded",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "qwc_build_iconfont && esbuild viewer.jsx --bundle --minify --alias:openlayers=qwc2-lts/libs/openlayers.js --loader:.svg=dataurl --loader:.png=dataurl --loader:.jpg=dataurl --loader:.woff=dataurl --define:process.env.AvailableLanguages='[]' --outdir=dist",
    "start": "node server.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "axios": "1.21.0",
    "qwc2-lts": "2026.0.30",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.65.1"
  }
}
